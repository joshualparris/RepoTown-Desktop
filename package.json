{
  "name": "repotown-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Privacy-gated Steam development candidate",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "audit:privacy": "node tools/privacy-gate.mjs game",
    "verify:desktop": "node --check desktop/main.cjs && node --check tools/privacy-gate.mjs && node --check tools/snapshot-public.mjs && node tools/verify-desktop.mjs",
    "package:windows": "electron-builder --win zip --x64",
    "test:electron": "node tests/electron-smoke.mjs",
    "test:steam-ready": "npm run verify:desktop && npm run audit:privacy"
  },
  "devDependencies": {
    "electron": "39.0.0",
    "electron-builder": "26.0.0",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "au.com.repotown.desktop",
    "productName": "Repository Town",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "game/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "RepoTown-Desktop-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
